# Supabase project settings: Project URL and the public browser key.
# VITE_SUPABASE_ANON_KEY is supported for older Supabase projects.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# VITE_SUPABASE_ANON_KEY=your-anon-key
# Set this to true when the deployed Supabase `analyze` function is ready.
VITE_USE_ANALYSIS_BACKEND=false
VITE_BACKEND_API_URL=http://localhost:8787
